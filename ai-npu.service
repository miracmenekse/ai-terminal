[Unit]
Description=Yerel LLM sunucusu (OpenVINO, CPU veya NPU)
After=default.target

[Service]
Environment=LD_LIBRARY_PATH=%h/.local/share/ai-npu/lib
Environment=AI_NPU_DEVICE=CPU
ExecStart=%h/.local/share/ai-npu/venv/bin/python %h/.local/share/ai-npu/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
