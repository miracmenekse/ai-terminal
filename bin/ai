#!/usr/bin/env python3
"""KULLANIM
  ai <soru>                    cevap ver
  ai -e <istek>                komut üret, onayını sor, çalıştır
  <komut> 2>&1 | ai <soru>     çıktıyı/hatayı modele ver

ÖRNEK
  ai chmod 755 ne demek
  ai -e 8080 portunu hangi program dinliyor
  apt update 2>&1 | ai bu hata neden oldu
  journalctl --user -u ai-npu -n 30 | ai servis neden çalışmıyor

SERVİS
  systemctl --user status|restart|stop ai-npu

Soruyu tırnak içine almana gerek yok. Tırnak gerekir: ' " ` $ ! ( ) ; | karakterleri varsa."""
import json, os, stat, subprocess, sys, urllib.request

URL = "http://127.0.0.1:11435/v1/chat/completions"
def ask(prompt, mode=None, max_tokens=400):
    """Talimatlar sunucuda; burada sadece hangi mod oldugunu soyluyoruz."""
    req = urllib.request.Request(
        URL, json.dumps({"messages": [{"role": "user", "content": prompt}],
                         "mode": mode, "max_tokens": max_tokens}).encode(),
        {"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=300) as r:
            y = json.load(r)
            return y["choices"][0]["message"]["content"].strip(), y.get("risk")
    except urllib.error.URLError:
        sys.exit("ai: sunucuya ulaşılamadı. Başlat: systemctl --user start ai-npu")


def confirm(q):
    """Girdi boruyla geldiyse stdin dolu; onayı klavyeden al.
       Terminal yoksa (betik, cron) onay alınamaz -> çalıştırma."""
    try:
        tty = open("/dev/tty")
    except OSError:
        print("ai: terminal yok, komut çalıştırılmadı", file=sys.stderr)
        return ""
    with tty:
        sys.stdout.write(q); sys.stdout.flush()
        return tty.readline().strip().lower()


args = sys.argv[1:]
if not args:
    sys.exit(__doc__)

# Sadece boru veya dosya yönlendirmesi varsa oku. isatty() yetmiyor: terminalsiz
# ortamda (betik, cron) girdi hiç gelmeyeceği halde sonsuza kadar bekliyordu.
# Kırpmayı sunucu yapar, sınırı bilen o; buradaki tavan kazara `cat *.log` içindir.
_m = os.fstat(sys.stdin.fileno()).st_mode
piped = sys.stdin.read()[-40000:] if stat.S_ISFIFO(_m) or stat.S_ISREG(_m) else ""

UYARI = "\033[1;33m  ⚠ geri dönüşü olmayan bir komut içeriyor, okumadan uygulama\033[0m"

if args[0] == "-e":
    cmd, risk = ask(" ".join(args[1:]) + piped, "exec", 120)
    print(f"\n  \033[1m{cmd}\033[0m\n")
    if risk:
        print(UYARI + "\n")
    if confirm("çalıştır? [e/H] ") in ("e", "y"):
        subprocess.run(cmd, shell=True)
else:
    q = " ".join(args)
    # Boruyla gelen metni etiketliyorum; etiketsizken model çıktıyı yorumlamak
    # yerine komutu açıklıyordu.
    cevap, risk = (ask(f"Komut çıktısı:\n{piped}\n\nSoru: {q}", "pipe") if piped
                   else ask(q))
    print(cevap, flush=True)
    if risk:
        print(UYARI, file=sys.stderr)
