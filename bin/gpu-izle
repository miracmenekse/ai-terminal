#!/usr/bin/env bash
# iGPU izleme.
#   gpu-izle        tek satirlik ozet: saat, uyaniklik, motor yuzdeleri
#   gpu-izle -t     intel_gpu_top'un ham tablosu (tam ekran)
#   gpu-izle 200    ornekleme araligi (ms), varsayilan 500
#
# intel_gpu_top'un sutun duzeni:
#   req(1) act(2) irq(3) RC6(4) pkg(5)  RCS(6) BCS(9) VCS0(12) VCS1(15) VECS(18) UNKN(21)
# Arrow Lake'te hesaplama (compute) motorunun adi yok, isi UNKN sutununda gorunur:
# model cevap uretirken %80-96'ya cikar. Render/Blit/Video sifirda kalir, normal.
command -v intel_gpu_top >/dev/null || {
  echo "intel_gpu_top yok:  sudo apt install -y intel-gpu-tools"; exit 1; }
[ "$(cat /proc/sys/kernel/perf_event_paranoid)" -le 0 ] || {
  echo "Yetki yok. Ya 'sudo gpu-izle' calistir, ya da kalici olarak:"
  echo "  echo kernel.perf_event_paranoid=0 | sudo tee /etc/sysctl.d/60-perf.conf"
  echo "  sudo sysctl -p /etc/sysctl.d/60-perf.conf"; exit 1; }

[ "${1:-}" = "-t" ] && exec intel_gpu_top

echo "  saat   uyanık                  Render  Blit  Video  VidEnh  HESAPLAMA"
exec stdbuf -oL intel_gpu_top -l -s "${1:-500}" | awk '
  $1 ~ /^[0-9]+$/ {
    uyanik = 100 - $4
    bar = ""
    for (i = 0; i < int(uyanik/5); i++) bar = bar "#"
    printf "%5s MHz  %%%-3d %-20s %6.2f %5.2f %6.2f %7.2f %10.2f\n",
           $2, uyanik, bar, $6, $9, $12, $18, $21
    fflush()
  }'
