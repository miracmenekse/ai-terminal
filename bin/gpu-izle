#!/usr/bin/env bash
# iGPU izleme.
#   gpu-izle        tek satirlik ozet: saat, uyaniklik, motor yuzdeleri
#   gpu-izle -t     intel_gpu_top'un ham tablosu (tam ekran)
#   gpu-izle 200    ornekleme araligi (ms), varsayilan 500
command -v intel_gpu_top >/dev/null || {
  echo "intel_gpu_top yok:  sudo apt install -y intel-gpu-tools"; exit 1; }
[ "$(cat /proc/sys/kernel/perf_event_paranoid)" -le 0 ] || {
  echo "Yetki yok. Ya 'sudo gpu-izle' calistir, ya da kalici olarak:"
  echo "  echo kernel.perf_event_paranoid=0 | sudo tee /etc/sysctl.d/60-perf.conf"
  echo "  sudo sysctl -p /etc/sysctl.d/60-perf.conf"; exit 1; }

[ "${1:-}" = "-t" ] && exec intel_gpu_top

# script: intel_gpu_top boruya yazarken 4 KB tampon dolana kadar bekliyor,
#         sahte terminal verince satir satir akiyor. (stdbuf bu programda etkisiz.)
# python:  mawk GIRDIYI tamponluyor, -Winteractive'i de "vacuous" deyip yok sayiyor.
exec script -qec "intel_gpu_top -l -s ${1:-500}" /dev/null | python3 -u -c '
import sys
# intel_gpu_top -l sutunlari:
#   req(0) act(1) irq(2) RC6(3) pkg(4)  RCS(5) BCS(8) VCS0(11) VCS1(14) VECS(17) UNKN(20)
# Arrow Lake ta hesaplama motorunun adi yok, isi UNKN sutununda gorunur.
print("  saat   uyanık                  Render  Blit  Video  VidEnh  HESAPLAMA")
for satir in sys.stdin:
    a = satir.split()
    if len(a) < 21 or not a[0].isdigit():
        continue
    try:
        uyanik = 100 - float(a[3])
        print("%5s MHz  %%%-3d %-20s %6.2f %5.2f %6.2f %7.2f %10.2f"
              % (a[1], uyanik, "#" * int(uyanik / 5),
                 float(a[5]), float(a[8]), float(a[11]), float(a[17]), float(a[20])))
    except ValueError:
        continue
'
